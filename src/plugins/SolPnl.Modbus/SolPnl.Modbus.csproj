<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Modbus TCP client shared by plugins that read devices over Modbus TCP. Not a plugin itself: each plugin package
    ships its own copy of SolPnl.Modbus.dll.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
