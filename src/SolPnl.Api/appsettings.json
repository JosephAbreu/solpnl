{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Storage. DriverName: sqlite (default, no setup), mysql (MySQL or MariaDB), mssql (SQL Server).
  // Examples:
  //   mysql: "Server=localhost;Database=solpnl;User=solpnl;Password=...;"
  //   mssql: "Server=myserver;Database=solpnl;User Id=solpnl;Password=...;TrustServerCertificate=true;"
  "Db": {
    "DriverName": "sqlite",
    "ConnectionString": "Data Source=solpnl.db"
  },

  "Polling": {
    "IntervalSeconds": 10
  },

  // How long each resolution is kept, in days (0 = forever). Raw readings are summarised per minute,
  // minutes per hour; data is only deleted after it has been summarised.
  "Retention": {
    "RawDays": 7,
    "MinuteDays": 90,
    "HourDays": 0,
    "MaintenanceIntervalSeconds": 60
  }

  // Device plugins are configured per machine in appsettings.Local.json (not committed), e.g.:
  // "Plugins": {
  //   "SolarmanSrne": { "Host": "192.168.1.50", "LoggerSerial": 2712345678 }
  // }
}
