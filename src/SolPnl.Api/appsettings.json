{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Storage is chosen in the setup wizard on first start (http://<host>:<port>/setup), which saves a "Db" section
  // to appsettings.Local.json in the data directory (SOLPNL_DATA_DIR, or the content root). It can also be set by hand:
  //   "Db": { "DriverName": "sqlite" | "mysql" | "mssql", "ConnectionString": "..." }
  //   sqlite: "Data Source=/var/lib/solpnl/solpnl.db"
  //   mysql (MySQL or MariaDB): "Server=localhost;Database=solpnl;User=solpnl;Password=...;"
  //   mssql: "Server=myserver;Database=solpnl;User Id=solpnl;Password=...;TrustServerCertificate=true;"

  "Polling": {
    "IntervalSeconds": 10
  },

  // How long each resolution is kept, in days (0 = forever). Raw readings are summarised per minute,
  // minutes per hour; data is only deleted after it has been summarised.
  "Retention": {
    "RawDays": 7,
    "MinuteDays": 90,
    "HourDays": 0,
    "MaintenanceIntervalSeconds": 60
  }

  // Device plugins are configured per machine in appsettings.Local.json (not committed), e.g.:
  // "Plugins": {
  //   "SolarmanSrne": { "Host": "192.168.1.50", "LoggerSerial": 2712345678 }
  // }
}
