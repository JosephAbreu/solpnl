<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
  </ItemGroup>

  <!-- Machine-specific settings and local data stay on the machine: never copy them into a published release. -->
  <ItemGroup>
    <Content Update="appsettings.Local.json;appsettings.Development.json" CopyToPublishDirectory="Never" />
    <None Update="*.db;*.db-shm;*.db-wal" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SolPnl.Core\SolPnl.Core.csproj" />
    <ProjectReference Include="..\SolPnl.Web\SolPnl.Web.csproj" />
  </ItemGroup>

  <!--
    Built-in plugins. SolPnl doesn't compile them in: each one's build output is a package, copied to plugins/<name>/
    next to SolPnl (in the build output and in a published release) and loaded at startup, so it can be removed like
    a plugin added later. The project references only make sure they're built first.
  -->
  <ItemGroup>
    <SolPnlPlugin Include="..\plugins\SolPnl.Plugin.SolarmanSrne\SolPnl.Plugin.SolarmanSrne.csproj" />
    <SolPnlPlugin Include="..\plugins\SolPnl.Plugin.SolarmanDeye\SolPnl.Plugin.SolarmanDeye.csproj" />
    <SolPnlPlugin Include="..\plugins\SolPnl.Plugin.SunSpec\SolPnl.Plugin.SunSpec.csproj" />
    <SolPnlPlugin Include="..\plugins\SolPnl.Plugin.HuaweiSun2000\SolPnl.Plugin.HuaweiSun2000.csproj" />
    <SolPnlPlugin Include="..\plugins\SolPnl.Plugin.Sungrow\SolPnl.Plugin.Sungrow.csproj" />
    <SolPnlPlugin Include="..\plugins\SolPnl.Plugin.VictronGx\SolPnl.Plugin.VictronGx.csproj" />
    <SolPnlPlugin Include="..\plugins\SolPnl.Plugin.Simulator\SolPnl.Plugin.Simulator.csproj" />
    <SolPnlPlugin Include="..\plugins\SolPnl.Plugin.OpenMeteo\SolPnl.Plugin.OpenMeteo.csproj" />
    <SolPnlPlugin Include="..\plugins\SolPnl.Plugin.NwsAlerts\SolPnl.Plugin.NwsAlerts.csproj" />
    <SolPnlPlugin Include="..\plugins\SolPnl.Plugin.Notify.Smtp\SolPnl.Plugin.Notify.Smtp.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="@(SolPnlPlugin)" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <Target Name="ResolveSolPnlPlugins">
    <!-- Plugins are portable class libraries: ask for their output without this project's runtime identifier. -->
    <MSBuild Projects="@(SolPnlPlugin)" Targets="GetTargetPath" Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_SolPnlPluginOutput" />
    </MSBuild>
    <ItemGroup>
      <!--
        The package is the plugin's top-level output files (built-in plugins have no native libraries). SolPnl.Contracts
        always comes from SolPnl itself, so packages leave it out.
      -->
      <_SolPnlPluginFile Include="%(_SolPnlPluginOutput.RootDir)%(_SolPnlPluginOutput.Directory)*"
                         Exclude="%(_SolPnlPluginOutput.RootDir)%(_SolPnlPluginOutput.Directory)SolPnl.Contracts.*"
                         PluginFolder="%(_SolPnlPluginOutput.Filename)" />
    </ItemGroup>
  </Target>

  <Target Name="CopySolPnlPlugins" AfterTargets="Build" DependsOnTargets="ResolveSolPnlPlugins">
    <RemoveDir Directories="$(OutDir)plugins" />
    <Copy SourceFiles="@(_SolPnlPluginFile)" DestinationFiles="$(OutDir)plugins\%(PluginFolder)\%(Filename)%(Extension)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishSolPnlPlugins" AfterTargets="Publish" DependsOnTargets="ResolveSolPnlPlugins">
    <RemoveDir Directories="$(PublishDir)plugins" />
    <Copy SourceFiles="@(_SolPnlPluginFile)" Condition="'%(Extension)' != '.pdb'"
          DestinationFiles="$(PublishDir)plugins\%(PluginFolder)\%(Filename)%(Extension)" />
  </Target>

</Project>
