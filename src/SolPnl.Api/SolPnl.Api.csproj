<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
  </ItemGroup>

  <!-- Machine-specific settings and local data stay on the machine: never copy them into a published release. -->
  <ItemGroup>
    <Content Update="appsettings.Local.json;appsettings.Development.json" CopyToPublishDirectory="Never" />
    <None Update="*.db;*.db-shm;*.db-wal" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SolPnl.Core\SolPnl.Core.csproj" />
    <ProjectReference Include="..\SolPnl.Web\SolPnl.Web.csproj" />
    <ProjectReference Include="..\plugins\SolPnl.Plugin.SolarmanSrne\SolPnl.Plugin.SolarmanSrne.csproj" />
    <ProjectReference Include="..\plugins\SolPnl.Plugin.Simulator\SolPnl.Plugin.Simulator.csproj" />
    <ProjectReference Include="..\plugins\SolPnl.Plugin.OpenMeteo\SolPnl.Plugin.OpenMeteo.csproj" />
    <ProjectReference Include="..\plugins\SolPnl.Plugin.NwsAlerts\SolPnl.Plugin.NwsAlerts.csproj" />
    <ProjectReference Include="..\plugins\SolPnl.Plugin.Notify.Smtp\SolPnl.Plugin.Notify.Smtp.csproj" />
  </ItemGroup>

</Project>
