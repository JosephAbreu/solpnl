-- 2: per-minute and per-hour summaries, rollup progress
create table if not exists reading_rollup (
    device_id integer not null references device (id),
    metric_id integer not null references metric (id),
    resolution_ms integer not null,
    bucket_ms integer not null,
    value_sum real not null,
    value_min real not null,
    value_max real not null,
    sample_count integer not null,
    primary key (device_id, metric_id, resolution_ms, bucket_ms)
) without rowid;
create index if not exists ix_reading_rollup_bucket on reading_rollup (resolution_ms, bucket_ms);

create table if not exists rollup_state (
    resolution_ms integer not null primary key,
    watermark_ms integer not null
);
