-- 2: per-minute and per-hour summaries, rollup progress (MySQL and MariaDB)
create table if not exists reading_rollup (
    device_id int not null,
    metric_id int not null,
    resolution_ms bigint not null,
    bucket_ms bigint not null,
    value_sum double not null,
    value_min double not null,
    value_max double not null,
    sample_count int not null,
    primary key (device_id, metric_id, resolution_ms, bucket_ms),
    key ix_reading_rollup_bucket (resolution_ms, bucket_ms),
    constraint fk_reading_rollup_device foreign key (device_id) references device (id),
    constraint fk_reading_rollup_metric foreign key (metric_id) references metric (id)
) engine = InnoDB;

create table if not exists rollup_state (
    resolution_ms bigint not null,
    watermark_ms bigint not null,
    primary key (resolution_ms)
) engine = InnoDB;
