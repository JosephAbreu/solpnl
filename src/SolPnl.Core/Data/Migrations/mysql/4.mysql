-- 4: one row per local day: sun times, forecast (as it stood before the day), actuals (MySQL and MariaDB)
create table if not exists day_summary (
    day varchar(10) not null,
    sunrise_ms bigint null,
    sunset_ms bigint null,
    forecast_high double null,
    forecast_low double null,
    forecast_irradiation double null,
    clear_sky_irradiation double null,
    actual_high double null,
    actual_low double null,
    solar_wh double null,
    load_wh double null,
    grid_wh double null,
    updated_ms bigint not null,
    primary key (day)
) engine = InnoDB;
