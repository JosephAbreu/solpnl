-- 2: per-minute and per-hour summaries, rollup progress
create table reading_rollup (
    device_id int not null constraint fk_reading_rollup_device references device (id),
    metric_id int not null constraint fk_reading_rollup_metric references metric (id),
    resolution_ms bigint not null,
    bucket_ms bigint not null,
    value_sum float not null,
    value_min float not null,
    value_max float not null,
    sample_count int not null,
    constraint pk_reading_rollup primary key (device_id, metric_id, resolution_ms, bucket_ms)
);
create index ix_reading_rollup_bucket on reading_rollup (resolution_ms, bucket_ms);

create table rollup_state (
    resolution_ms bigint not null constraint pk_rollup_state primary key,
    watermark_ms bigint not null
);
