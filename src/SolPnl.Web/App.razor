@* Pages and layout live in SolPnl.Ui so other shells (e.g. a MAUI Blazor Hybrid app) can reuse them. *@
<Router AppAssembly="@typeof(SolPnl.Ui.Layout.MainLayout).Assembly" NotFoundPage="typeof(SolPnl.Ui.Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(SolPnl.Ui.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
