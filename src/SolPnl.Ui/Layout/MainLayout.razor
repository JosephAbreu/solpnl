@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IThemeService Theme

@* Portal-style shell: top bar (brand, global search, settings), collapsible left navigation, content. *@
<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header" Class="shell-header">
        <FluentLayoutHamburger />
        <a class="brand" href="./">
            <SolPnlLogo />
            <span>SolPnl</span>
        </a>

        <form class="search" role="search" @onsubmit="Search">
            <FluentTextInput @bind-Value="_query" Placeholder="Search devices" aria-label="Search devices"
                             StartTemplate="@SearchIcon" Width="100%" />
        </form>

        <FluentSpacer />

        <FluentButton Appearance="ButtonAppearance.Transparent" IconOnly="true" Title="About SolPnl"
                      aria-label="About SolPnl" OnClick="@(() => Nav.NavigateTo("about"))"
                      IconStart="@(new Icons.Regular.Size20.Info().WithColor("#ffffff"))" />

        <FluentButton Appearance="ButtonAppearance.Transparent" IconOnly="true" Title="Switch light/dark theme"
                      aria-label="Switch light/dark theme" OnClick="ToggleThemeAsync"
                      IconStart="@(new Icons.Regular.Size20.DarkTheme().WithColor("#ffffff"))" />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Navigation">
        <NavMenu />
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Content" Class="shell-content">
        <ErrorBoundary @ref="_errorBoundary">
            <ChildContent>
                @* Pages render only once we know setup isn't needed, so they don't call an API that isn't ready. *@
                @if (_ready)
                {
                    @Body
                }
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="page">
                    <FluentMessageBar Intent="MessageBarIntent.Error" Title="Something went wrong">@ex.Message</FluentMessageBar>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </FluentLayoutItem>
</FluentLayout>

<FluentProviders />

@code {
    private string? _query;
    private ErrorBoundary? _errorBoundary;
    private bool _ready;

    private static readonly RenderFragment SearchIcon =
        @<FluentIcon Value="@(new Icons.Regular.Size16.Search())" />;

    [Inject] private SolPnlApi Api { get; set; } = default!;

    protected override void OnParametersSet() => _errorBoundary?.Recover();

    // First run: nothing works until storage is chosen, so send the user to the setup wizard.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            if ((await Api.GetSetupStatusAsync()).SetupRequired)
            {
                Nav.NavigateTo("setup", replace: true);
                return;
            }
            MetricFormat.TemperatureUnit = (await Api.GetSettingsAsync()).TemperatureUnit;
        }
        catch (HttpRequestException)
        {
            // Pages show their own "can't reach SolPnl" message.
        }
        _ready = true;
    }

    private void Search() =>
        Nav.NavigateTo(string.IsNullOrWhiteSpace(_query) ? "devices" : $"devices?q={Uri.EscapeDataString(_query.Trim())}");

    private Task ToggleThemeAsync() => Theme.SwitchThemeAsync();
}
