@page "/alerts"
@implements IDisposable
@inject SolPnlApi Api
@inject NavigationManager Nav

<PageTitle>Alerts · SolPnl</PageTitle>

<div class="page">
    <PageHeader Title="Alerts" Subtitle="What SolPnl noticed, and whether it was sent" Icon="@(new Icons.Regular.Size24.Alert())"
                Breadcrumbs="@([("Home", ""), ("Alerts", null)])">
        <Commands>
            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.ArrowClockwise())" OnClick="ReloadAsync">Refresh</FluentButton>
            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size20.Settings())"
                          OnClick="@(() => Nav.NavigateTo("settings#notifications"))">Notification settings</FluentButton>
        </Commands>
    </PageHeader>

    @if (_error is not null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Warning" Title="Can't reach the SolPnl service">@_error</FluentMessageBar>
    }

    <div class="filters" role="group" aria-label="Category">
        @foreach (var (key, label) in Categories)
        {
            <button type="button" class="filter @(_category == key ? "selected" : null)" aria-pressed="@(_category == key ? "true" : "false")"
                    @onclick="() => SetCategory(key)">@label</button>
        }
    </div>

    @if (_history.Any(a => a.Status == AlertDeliveryStatus.Waiting))
    {
        <FluentMessageBar Intent="MessageBarIntent.Info" Title="Not sent yet">
            Some alerts are waiting because no notification channel is set up. <a href="settings">Set up email</a> and they'll be sent
            (alerts older than 24 hours aren't sent).
        </FluentMessageBar>
    }

    <section class="panel" aria-labelledby="active-heading">
        <h2 id="active-heading">Going on now</h2>
        @if (_loaded && _active.Count == 0)
        {
            <p class="quiet"><FluentIcon Value="@(new Icons.Filled.Size20.CheckmarkCircle())" Color="Color.Custom" CustomColor="var(--status-good)" />
                Nothing going on right now.</p>
        }
        else
        {
            <ul class="active">
                @foreach (var a in _active)
                {
                    <li>
                        <SeverityIcon Severity="@a.Severity" />
                        <strong>@a.Title</strong>
                        <span class="muted">@CategoryLabel(a.Category) · since @When(a.Since)</span>
                    </li>
                }
            </ul>
        }
    </section>

    @if (_grid is { } grid && (_category is null || _category == AlertCategories.Grid))
    {
        <section class="panel" aria-labelledby="grid-heading">
            <h2 id="grid-heading">Grid power</h2>
            <p class="grid-summary">
                Last @grid.Days days:
                <strong>@(grid.Outages == 0 ? "no outages" : grid.Outages == 1 ? "1 outage" : $"{grid.Outages} outages")</strong>@(grid.Outages > 0 ? $", {OutageTotal(grid.OutageMinutes)} in total" : "").
            </p>
            @if (grid.Events.Count > 0)
            {
                <table class="grid-events">
                    <thead><tr><th scope="col">What</th><th scope="col">Started</th><th scope="col">Lasted</th><th scope="col" class="num">Voltage</th></tr></thead>
                    <tbody>
                        @foreach (var e in grid.Events.Take(_showAllGrid ? grid.Events.Count : 10))
                        {
                            <tr>
                                <td>@GridKind(e.Kind)</td>
                                <td>@When(e.StartedAt)</td>
                                <td>@(e.EndedAt is { } end ? Lasted(end - e.StartedAt) : "Still going on")</td>
                                <td class="num">@(e.Extreme is { } v ? $"{(e.Kind == GridEventKinds.High ? "max" : "min")} {v:0.0} V" : "–")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (!_showAllGrid && grid.Events.Count > 10)
                {
                    <button type="button" class="link" @onclick="() => _showAllGrid = true">Show all @grid.Events.Count</button>
                }
            }
            <p class="hint">From the grid voltage your inverter reports. If SolPnl itself loses power in an outage, that time isn't seen.</p>
        </section>
    }

    <section class="panel" aria-labelledby="history-heading">
        <h2 id="history-heading">History</h2>
        @if (_loaded && _history.Count == 0)
        {
            <p class="quiet">No alerts yet. Alerts appear here when devices go offline, grid power goes out, weather alerts are issued for your location,
                solar output falls below the forecast, or a scheduled backup fails.</p>
        }
        else
        {
            <ol class="history">
                @foreach (var a in _history)
                {
                    <li>
                        <details>
                            <summary>
                                <SeverityIcon Severity="@a.Severity" />
                                <span class="title">@a.Title</span>
                                <span class="category">@CategoryLabel(a.Category)</span>
                                <span class="time" title="@a.RaisedAt.ToLocalTime().ToString("F", CultureInfo.CurrentCulture)">@When(a.RaisedAt)</span>
                                <span class="status @a.Status">@StatusLabel(a.Status)</span>
                            </summary>
                            <div class="body">
                                <p class="message">@a.Message</p>
                                <dl>
                                    <dt>Raised</dt>
                                    <dd>@a.RaisedAt.ToLocalTime().ToString("F", CultureInfo.CurrentCulture)</dd>
                                    @if (a.DeliveredAt is { } delivered)
                                    {
                                        <dt>Sent</dt>
                                        <dd>@delivered.ToLocalTime().ToString("F", CultureInfo.CurrentCulture)</dd>
                                    }
                                    @if (!string.IsNullOrEmpty(a.Delivery))
                                    {
                                        <dt>Delivery</dt>
                                        <dd class="delivery">@a.Delivery</dd>
                                    }
                                    @if (a.DeviceId is { } device)
                                    {
                                        <dt>Device</dt>
                                        <dd><a href="@($"devices/{Uri.EscapeDataString(device)}")">@device</a></dd>
                                    }
                                </dl>
                            </div>
                        </details>
                    </li>
                }
            </ol>
            @if (_hasMore)
            {
                <div class="more">
                    <FluentButton Appearance="ButtonAppearance.Outline" OnClick="LoadMoreAsync" Loading="_loadingMore" Disabled="_loadingMore">Show older alerts</FluentButton>
                </div>
            }
        }
    </section>
</div>

@code {
    private static readonly (string? Key, string Label)[] Categories =
    [
        (null, "All"),
        (AlertCategories.Device, "Devices"),
        (AlertCategories.Grid, "Grid"),
        (AlertCategories.Weather, "Weather"),
        (AlertCategories.Solar, "Solar"),
        (AlertCategories.System, "System"),
        (AlertCategories.Test, "Tests"),
    ];

    [SupplyParameterFromQuery(Name = "category")] public string? CategoryKey { get; set; }

    private string? _category;
    private List<ActiveAlert> _active = [];
    private List<AlertEntry> _history = [];
    private bool _hasMore, _loaded, _loadingMore;
    private string? _error;
    private GridHistory? _grid;
    private bool _showAllGrid;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnParametersSetAsync()
    {
        _category = Categories.Any(c => c.Key == CategoryKey) ? CategoryKey : null;
        await ReloadAsync();
    }

    protected override void OnInitialized() => _ = PollAsync(_cts.Token);

    private void SetCategory(string? key) => Nav.NavigateTo(Nav.GetUriWithQueryParameter("category", key));

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(30));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                // Refresh only the first page, so expanded items and "show older" results aren't lost.
                if (_history.Count <= 50)
                {
                    await ReloadAsync();
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            var page = await Api.GetAlertsAsync(_category, ct: _cts.Token);
            _active = page.Active.ToList();
            _history = page.History.ToList();
            _hasMore = page.HasMore;
            _grid = await Api.GetGridHistoryAsync(ct: _cts.Token);
            _error = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _error = ex.Message;
        }
        catch (OperationCanceledException)
        {
        }
        _loaded = true;
    }

    private async Task LoadMoreAsync()
    {
        if (_history.Count == 0) return;
        _loadingMore = true;
        try
        {
            var page = await Api.GetAlertsAsync(_category, before: _history[^1].Id, ct: _cts.Token);
            _history.AddRange(page.History);
            _hasMore = page.HasMore;
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _error = ex.Message;
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private static string When(DateTimeOffset t)
    {
        var age = DateTimeOffset.UtcNow - t;
        return age < TimeSpan.FromDays(1)
            ? MetricFormat.Ago(t, DateTimeOffset.UtcNow)
            : t.ToLocalTime().ToString("MMM d, h:mm tt", CultureInfo.CurrentCulture);
    }

    private static string GridKind(string kind) => kind switch
    {
        GridEventKinds.Outage => "Outage",
        GridEventKinds.Low => "Low voltage",
        GridEventKinds.High => "High voltage",
        _ => kind,
    };

    private static string Lasted(TimeSpan span) => span switch
    {
        { TotalMinutes: < 1 } => $"{Math.Max(0, (int)span.TotalSeconds)} s",
        { TotalHours: < 1 } => $"{(int)span.TotalMinutes} min",
        { TotalDays: < 1 } => $"{(int)span.TotalHours} h {span.Minutes} min",
        _ => $"{(int)span.TotalDays} d {span.Hours} h",
    };

    private static string OutageTotal(double minutes) => Lasted(TimeSpan.FromMinutes(minutes));

    private static string CategoryLabel(string category) => category switch
    {
        AlertCategories.Device => "Device",
        AlertCategories.Grid => "Grid",
        AlertCategories.Weather => "Weather",
        AlertCategories.Solar => "Solar",
        AlertCategories.System => "System",
        AlertCategories.Test => "Test",
        _ => category,
    };

    private static string StatusLabel(string status) => status switch
    {
        AlertDeliveryStatus.Sent => "Sent",
        AlertDeliveryStatus.Failed => "Failed, will retry",
        AlertDeliveryStatus.Waiting => "Waiting for a channel",
        AlertDeliveryStatus.NotSent => "Not sent",
        _ => status,
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
